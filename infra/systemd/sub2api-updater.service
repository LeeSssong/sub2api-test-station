[Unit]
Description=Sub2API host-controlled update service
Wants=docker.service network-online.target
After=docker.service network-online.target
ConditionPathExists=/usr/local/libexec/sub2api-updater
ConditionPathExists=/opt/sub2api/production/ops/update-sub2api-host.sh

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sub2api/production
EnvironmentFile=/etc/sub2api/sub2api-updater.env
ExecStart=/usr/local/libexec/sub2api-updater --socket ${SUB2API_UPDATER_SOCKET} --state ${SUB2API_UPDATER_STATE} --executor ${SUB2API_UPDATER_EXECUTOR} --official-api ${SUB2API_UPDATER_OFFICIAL_API} --official-dial-address ${SUB2API_UPDATER_OFFICIAL_DIAL_ADDRESS} --origin ${SUB2API_UPDATER_ORIGIN} --github-latest-release ${SUB2API_UPDATER_GITHUB_LATEST_RELEASE}
Restart=on-failure
RestartSec=5s
RuntimeDirectory=sub2api-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
StateDirectory=sub2api-updater
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=30s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/sub2api/production /var/lib/sub2api-updater

[Install]
WantedBy=multi-user.target
