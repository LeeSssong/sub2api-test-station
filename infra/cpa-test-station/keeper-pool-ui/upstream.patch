@@ -0,0 +1,55 @@
+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { PoolQuotaCard } from '../PoolQuotaCard'
+const pricing = vi.fn()
+const cache = vi.fn()
+const refresh = vi.fn()
+vi.mock('@/lib/api', () => ({
+  fetchPricing: (...args: unknown[]) => pricing(...args),
+  fetchPricingRules: async () => ({ rules: null }),
+  fetchUsageIdentities: async () => ({ identities: [
+    { auth_type: 1, type: 'codex', disabled: false, is_deleted: false, identity: 'b' },
+    { auth_type: 1, type: 'codex', disabled: false, is_deleted: false, identity: 'a' },
+    { auth_type: 1, type: 'codex', disabled: true, is_deleted: false, identity: 'disabled' },
+  ] }),
+  fetchUsageQuotaCache: (...args: unknown[]) => cache(...args),
+  refreshUsageQuotas: (...args: unknown[]) => refresh(...args),
+  fetchUsageEvents: async () => ({ events: [], has_more: false }),
+}))
+let container: HTMLDivElement
+let root: Root
+beforeEach(() => {
+  (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true
+  const values = new Map<string, string>()
+  Object.defineProperty(window, 'localStorage', { configurable: true, value: { getItem: (key: string) => values.get(key) ?? null, setItem: (key: string, value: string) => values.set(key, value), clear: () => values.clear() } })
+  pricing.mockResolvedValue({ pricing: [{ model: 'model', price_multiplier: 1 }] })
+  refresh.mockResolvedValue({ accepted: 2, tasks: [], rejected: null })
+  cache.mockImplementation(async () => ({ items: ['a', 'b'].map(id => ({ auth_index: id, status: 'completed', refreshed_at: new Date().toISOString(), quota: { subscription: { plan: 'same' }, quota: [{ scope: 'window', window: { seconds: 604800 }, usedPercent: 5, resetAt: '2026-10-18T00:00:00Z' }] } })) }))
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+})
+afterEach(async () => { await act(async () => root.unmount()); container.remove() })
+it('starts a new pool baseline using all enabled Codex identities, never credential token stats', async () => {
+  await act(async () => { root.render(<PoolQuotaCard />) })
+  expect(refresh.mock.calls[0][0]).toEqual(['a', 'b'])
+  expect(container.textContent).toContain('2 个账号')
+  expect(container.textContent).toContain('等待采样')
+  expect(container.textContent).toContain('采样下降 0.0 个百分点')
+  expect(container.textContent).toContain('模拟扣费倍率')
+  expect(window.localStorage.getItem('xingqiao-keeper-pool-baseline-v1:')).not.toBeNull()
+})
+it('never labels multiplied prices as 1x standard usage', async () => {
+  pricing.mockResolvedValue({ pricing: [{ model: 'model', price_multiplier: 0.2 }] })
+  await act(async () => root.render(<PoolQuotaCard />))
+  expect(container.querySelector('[role=alert]')?.textContent).toContain('价格倍率设为 1')
+  expect(window.localStorage.getItem('xingqiao-keeper-pool-baseline-v1:')).toBeNull()
+})
+it('refuses missing weekly windows instead of dropping accounts from the pool', async () => {
+  cache.mockResolvedValue({ items: [] })
+  refresh.mockResolvedValue({ tasks: [], rejected: [{ authIndex: 'a', error: 'not_found' }] })
+  await act(async () => root.render(<PoolQuotaCard />))
+  expect(container.querySelector('[role=alert]')?.textContent).toContain('部分账号')
+})
diff --git a/web/src/components/usage/pool/test/poolMath.test.ts b/web/src/components/usage/pool/test/poolMath.test.ts
