# Example values make Compose validation deterministic. Never deploy this file.
SITE_ADDRESS=api.example.com
TZ=Asia/Shanghai
SUB2API_DATA_DIR=./data
POSTGRES_DATA_DIR=./postgres_data
REDIS_DATA_DIR=./redis_data
SERVER_TRUSTED_PROXIES=172.16.0.0/12
SERVER_MAX_REQUEST_BODY_SIZE=134217728
GATEWAY_MAX_BODY_SIZE=134217728
GATEWAY_TEXT_MAX_BODY_SIZE=16777216

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=example-only-postgres-password
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=60
POSTGRES_SHARED_BUFFERS=128MB
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5

REDIS_PASSWORD=example-only-redis-password
REDIS_MAXCLIENTS=1000
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=5

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=example-only-admin-password
JWT_SECRET=example-only-jwt-secret
TOTP_ENCRYPTION_KEY=example-only-totp-key

SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=

# Global OpenAI low-latency relay baseline. No account-level settings.
GATEWAY_OPENAI_WS_ENABLED=true
GATEWAY_OPENAI_WS_RESPONSES_WEBSOCKETS_V2=true
GATEWAY_OPENAI_WS_MIN_IDLE_PER_ACCOUNT=4
GATEWAY_OPENAI_WS_MAX_IDLE_PER_ACCOUNT=12
GATEWAY_OPENAI_WS_DYNAMIC_MAX_CONNS_BY_ACCOUNT_CONCURRENCY_ENABLED=true
GATEWAY_OPENAI_WS_POOL_TARGET_UTILIZATION=0.70
GATEWAY_OPENAI_WS_QUEUE_LIMIT_PER_CONN=16
GATEWAY_OPENAI_WS_EVENT_FLUSH_BATCH_SIZE=1
GATEWAY_OPENAI_WS_EVENT_FLUSH_INTERVAL_MS=10
GATEWAY_OPENAI_WS_STORE_DISABLED_CONN_MODE=strict
GATEWAY_OPENAI_WS_STORE_DISABLED_FORCE_NEW_CONN=true
GATEWAY_OPENAI_WS_PREWARM_GENERATE_ENABLED=false
GATEWAY_OPENAI_WS_LB_TOP_K=7
GATEWAY_OPENAI_WS_SCHEDULER_SCORE_WEIGHTS_QUEUE=1.2
GATEWAY_OPENAI_WS_SCHEDULER_SCORE_WEIGHTS_ERROR_RATE=1.2
GATEWAY_OPENAI_WS_SCHEDULER_SCORE_WEIGHTS_TTFT=1.5
GATEWAY_OPENAI_SCHEDULER_STICKY_ESCAPE_ENABLED=true
GATEWAY_OPENAI_SCHEDULER_STICKY_ESCAPE_TTFT_MS=8000
GATEWAY_OPENAI_SCHEDULER_STICKY_ESCAPE_ERROR_RATE=0.30
GATEWAY_OPENAI_HTTP2_ENABLED=true
GATEWAY_OPENAI_HTTP2_ALLOW_PROXY_FALLBACK_TO_HTTP1=true

# relay-ops monitoring. Real secret files live outside Git.
RELAY_OPS_MODE=read_only
RELAY_OPS_ACCOUNTING_ENABLED=false
RELAY_OPS_ACCOUNTING_LEDGER_START_DATE=
RELAY_OPS_ACCOUNTING_INTERNAL_USER_IDS=
RELAY_OPS_ACCOUNTING_INTERNAL_API_KEY_IDS=
RELAY_OPS_DATABASE_URL_HOST_FILE=./secrets/relay-ops-database-url
RELAY_OPS_SUB2API_ADMIN_KEY_HOST_FILE=./secrets/sub2api-admin-api-key
# Fallback transport only. When RELAY_OPS_FEISHU_ALERT_CHAT_ID_FILE is set,
# notifications go through the App Bot (im/v1/messages) and these two are
# ignored. Production leaves them empty; keep them for a deployment that has a
# group webhook but no App Bot.
RELAY_OPS_FEISHU_WEBHOOK_FILE=
RELAY_OPS_FEISHU_WEBHOOK_HOST_FILE=
# App Bot chat delivery is disabled while this complete set is empty. When
# enabling it, configure App ID, App Secret, alert chat, recipients, and all
# matching host-file values together.
# RELAY_OPS_FEISHU_ALERT_RECIPIENTS_FILE=/run/secrets/feishu-alert-recipients.json
# RELAY_OPS_FEISHU_ALERT_RECIPIENTS_HOST_FILE=./secrets/feishu-alert-recipients.json
RELAY_OPS_FEISHU_APP_ID_FILE=
RELAY_OPS_FEISHU_APP_SECRET_FILE=
RELAY_OPS_FEISHU_ALERT_CHAT_ID_FILE=
RELAY_OPS_FEISHU_ALERT_RECIPIENTS_FILE=
RELAY_OPS_NOTIFICATION_POLICY_FILE=
RELAY_OPS_FEISHU_APP_ID_HOST_FILE=
RELAY_OPS_FEISHU_APP_SECRET_HOST_FILE=
RELAY_OPS_FEISHU_ALERT_CHAT_ID_HOST_FILE=
RELAY_OPS_FEISHU_ALERT_RECIPIENTS_HOST_FILE=
RELAY_OPS_NOTIFICATION_POLICY_HOST_FILE=
RELAY_OPS_AGENT_BASE_URL=
RELAY_OPS_AGENT_API_KEY_HOST_FILE=./secrets/agent-api-key
RELAY_OPS_AGENT_MODEL=
RELAY_OPS_CANDIDATE_KEYS_HOST_DIR=./secrets/candidate-keys
RELAY_OPS_CANDIDATE_MANAGED_KEYS_HOST_DIR=./secrets/candidate-managed-keys
RELAY_OPS_USAGE_SESSIONS_HOST_DIR=./secrets/upstream-sessions
RELAY_OPS_ACCOUNT_QUALITY_RESULT_HOST_DIR=./evidence/account-quality
# Upstream group-mapping pricing fallback. Leave both empty to disable.
# When enabled: HOST_FILE points at the mapping JSON on the host, and
# RELAY_OPS_UPSTREAM_GROUP_MAPPING_FILE is its in-container path
# (/run/relay-ops/upstream-group-mapping.json).
RELAY_OPS_UPSTREAM_GROUP_MAPPING_FILE=
RELAY_OPS_UPSTREAM_GROUP_MAPPING_HOST_FILE=
