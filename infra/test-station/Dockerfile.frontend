FROM node:24-alpine AS frontend-builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9 --activate
COPY upstream/sub2api/frontend/package.json upstream/sub2api/frontend/pnpm-lock.yaml ./frontend/
RUN cd frontend && pnpm install --frozen-lockfile --prefer-offline
COPY upstream/sub2api/frontend/ ./frontend/
COPY upstream/sub2api/docs/legal/ ./docs/legal/
RUN cd frontend && VITE_APP_BASE_PATH=/ VITE_API_BASE_URL=/api/v1 VITE_AUTH_STORAGE_PREFIX=test_station_ VITE_BUILD_OUT_DIR=/app/dist pnpm build
FROM nginx:1.27-alpine
COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY infra/test-station/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 4173
