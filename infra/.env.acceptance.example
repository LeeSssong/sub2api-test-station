# Example-only operator template. Copy outside the repository, replace every
# value, set mode 0600, and never deploy these placeholder values.
ACCEPTANCE_SITE_ADDRESS=api.xingqiaolab.top
ACCEPTANCE_DEPLOY_ROOT=/opt/sub2api/acceptance-example-invalid
ACCEPTANCE_PROJECT_NAME=sub2api-acceptance
ACCEPTANCE_NETWORK_NAME=sub2api-acceptance-network
ACCEPTANCE_LOOPBACK_BIND=0.0.0.0
ACCEPTANCE_LOOPBACK_PORT=8181
# Configure the production Caddy environment separately with the administrator
# source CIDRs. The default denies all non-local requests to /admin/lab/.

# The release controller replaces ACCEPTANCE_IMAGE with one immutable candidate.
ACCEPTANCE_IMAGE=example.invalid/sub2api/acceptance:replace-before-deploy
ACCEPTANCE_POSTGRES_IMAGE=postgres:18-alpine
ACCEPTANCE_REDIS_IMAGE=redis:8-alpine
ACCEPTANCE_CADDY_IMAGE=caddy:2.10.2-alpine

ACCEPTANCE_DB_NAME=acceptance_example_invalid
ACCEPTANCE_DB_USER=acceptance_example_invalid
ACCEPTANCE_DB_PASSWORD=INVALID-example-postgres-password-replace-me
ACCEPTANCE_REDIS_PASSWORD=INVALID-example-redis-password-replace-me
ACCEPTANCE_ADMIN_EMAIL=admin@acceptance.example.invalid
ACCEPTANCE_ADMIN_PASSWORD=INVALID-example-admin-password-replace-me
ACCEPTANCE_JWT_SECRET=INVALID-example-jwt-secret-replace-me
ACCEPTANCE_TOTP_ENCRYPTION_KEY=INVALID-example-totp-key-replace-me
ACCEPTANCE_DETECTOR_TOKEN=INVALID-example-detector-token-replace-me
ACCEPTANCE_TIMEZONE=Asia/Shanghai

# These declarations are for real, independently configured flows. Replace the
# provider identifiers with the actual non-example integrations before use.
ACCEPTANCE_PAYMENT_PROVIDER=real-payment-provider-replace-me
ACCEPTANCE_UPSTREAM_PROVIDER=real-upstream-provider-replace-me
ACCEPTANCE_NOTIFICATION_TRANSPORT=real-notification-transport-replace-me
ACCEPTANCE_REAL_FLOW_ACK=I_UNDERSTAND_REAL_CHARGES
