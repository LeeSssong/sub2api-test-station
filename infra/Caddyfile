{
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:172.18.0.1/32}
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	@homepage_index {
		path / /home /home/
		file {
			root /srv/home
			try_files /index.html
		}
	}
	handle @homepage_index {
		root * /srv/home
		rewrite * /index.html
		header Cache-Control "no-store, max-age=0"
		file_server
	}

	@homepage_config path /home-assets/site-config.json
	handle @homepage_config {
		root * /srv/home
		header Cache-Control "no-store, max-age=0"
		file_server
	}

	@homepage_assets path /home-assets/*
	handle @homepage_assets {
		root * /srv/home
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@docs_root path /docs
	redir @docs_root /docs/ 308

	@docs_index path /docs/
	handle @docs_index {
		root * /srv/home
		rewrite * /docs/index.html
		header Cache-Control "no-store, max-age=0"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		header X-Frame-Options SAMEORIGIN
		file_server
	}

	@docs_assets path /docs/*
	handle @docs_assets {
		root * /srv/home
		header Cache-Control "public, max-age=86400"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		header X-Frame-Options SAMEORIGIN
		file_server
	}

	@support_index path /support /support/
	handle @support_index {
		root * /srv/home
		rewrite * /index.html
		header Cache-Control "no-store, max-age=0"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		header X-Frame-Options SAMEORIGIN
		file_server
	}

	@support_assets path /support/*
	handle @support_assets {
		root * /srv/home
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@sub2api_update_js path /xingqiao-update-ui.js
	handle @sub2api_update_js {
		root * /srv/sub2api-update-ui
		rewrite * /update-ui.js
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@sub2api_update_css path /xingqiao-update-ui.css
	handle @sub2api_update_css {
		root * /srv/sub2api-update-ui
		rewrite * /update-ui.css
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@sub2api_binary_mutation {
		method POST
		path /api/v1/admin/system/rollback
	}
	respond @sub2api_binary_mutation `{"code":"DOCKER_DEPLOYMENT_UPDATE_REQUIRED","message":"Docker 部署仅支持受控 Compose 更新，请使用运维发布流程"}` 409

	@sub2api_official_index path /__sub2api-official-index
	handle @sub2api_official_index {
		rewrite * /
		reverse_proxy sub2api:8080
	}

	@legacy_ops path /ops /ops/*
	redir @legacy_ops /admin/ops 302

	@sub2api_html {
		header Accept *text/html*
		not {
			path /api/* /relay-ops/* /ops /ops/* /health /home-assets/* /xingqiao-update-ui.* /__sub2api-official-index
		}
	}
	handle @sub2api_html {
		root * /srv/sub2api-update-ui
		templates
		rewrite * /index.html
		file_server
	}

	@sub2api_version_check {
		method GET
		path /api/v1/admin/system/check-updates
	}
	reverse_proxy @sub2api_version_check sub2api:8080

	@sub2api_update {
		method POST
		path /api/v1/admin/system/update
	}
	reverse_proxy @sub2api_update unix//run/sub2api-updater/updater.sock {
		transport http {
			dial_timeout 5s
			response_header_timeout 15m
		}
	}

	@sub2api_host_update_status {
		method GET
		path /api/v1/admin/system/host-update/status
	}
	reverse_proxy @sub2api_host_update_status unix//run/sub2api-updater/updater.sock

	@sub2api_host_update_readiness {
		method GET
		path /api/v1/admin/system/host-update/readiness
	}
	reverse_proxy @sub2api_host_update_readiness unix//run/sub2api-updater/updater.sock

	@sub2api_host_update_schedule {
		method DELETE
		path /api/v1/admin/system/host-update/schedule
	}
	reverse_proxy @sub2api_host_update_schedule unix//run/sub2api-updater/updater.sock

	@sub2api_restart_mutation {
		method POST
		path /api/v1/admin/system/restart
	}
	respond @sub2api_restart_mutation `{"code":"DOCKER_DEPLOYMENT_UPDATE_REQUIRED","message":"Docker 部署仅支持受控 Compose 更新，请使用运维发布流程"}` 409

	@relay_ops_public {
		path /pricing /relay-ops/static/*
	}
	reverse_proxy @relay_ops_public relay-ops:8100

	reverse_proxy sub2api:8080 {
		flush_interval -1
		header_down Content-Security-Policy "frame-src " "frame-src 'self' https://shop.xingqiaolab.top https://catfk.com "
		transport http {
			dial_timeout 10s
			response_header_timeout 300s
			keepalive 30s
		}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	log {
		output stdout
		format json
	}
}

{$STOREFRONT_SITE_ADDRESS:https://shop.xingqiaolab.top} {
	encode zstd gzip

	@catfk_storefront_entry {
		path / /shop/DLK8SNUJ /shop/DLK8SNUJ/
	}
	handle @catfk_storefront_entry {
		route {
			# Match WAWA: CatFK receives the complete authenticated storefront query.
			header Cache-Control "no-store, max-age=0"
			header Content-Type "text/html; charset=utf-8"
			header Referrer-Policy "no-referrer"
			redir https://catfk.com/shop/DLK8SNUJ?{http.request.uri.query} 302
		}
	}

	respond 404

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; frame-ancestors https://api.xingqiaolab.top; base-uri 'none'; form-action 'none'"
	}
}
