map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

resolver 127.0.0.11 valid=10s ipv6=off;

upstream caddy_https {
    zone caddy_https 64k;
    server caddy-tls-origin:443 resolve;
    keepalive 64;
}

upstream caddy_http {
    zone caddy_http 64k;
    server caddy-tls-origin:80 resolve;
    keepalive 8;
}

server {
    listen 80;
    server_name ${SITE_ADDRESS};

    location ^~ /.well-known/acme-challenge/ {
        proxy_pass http://caddy_http;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SITE_ADDRESS};

    ssl_certificate /run/nginx-tls/${SITE_ADDRESS}.crt;
    ssl_certificate_key /run/nginx-tls/${SITE_ADDRESS}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-CHACHA20-POLY1305-SHA256;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 128m;

    location / {
        proxy_pass https://caddy_https;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }
}
