index 0000000..2a7b0fc
--- /dev/null
+++ b/web/src/components/usage/pool/poolMath.ts
@@ -0,0 +1,34 @@
+import type { UsageEvent } from '@/lib/types'
+export interface PoolBaseline { at: number; fingerprint: string; remaining: number[] }
+export function needsNewBaseline(base: PoolBaseline, fingerprint: string, remaining: number[]): boolean {
+  return base.fingerprint !== fingerprint || base.remaining.length !== remaining.length
+    || remaining.some((value, index) => value > base.remaining[index] + 0.00001)
+}
+export function estimatePool(base: PoolBaseline, remaining: number[], cost: number) {
+  if (!remaining.length || base.remaining.length !== remaining.length || !Number.isFinite(cost) || cost < 0
+    || [...base.remaining, ...remaining].some(value => !Number.isFinite(value) || value < 0 || value > 1)) {
+    throw new Error('号池采样数据无效')
+  }
+  const drop = base.remaining.reduce((sum, value, index) => sum + value - remaining[index], 0)
+  const left = remaining.reduce((sum, value) => sum + value, 0)
+  const ready = drop > 0.00001 && cost > 0
+  return { dropPoints: Math.max(0, drop * 100), averageRemaining: left / remaining.length,
+    total: ready ? cost / drop * remaining.length : null,
+    remaining: ready ? cost / drop * left : null }
+}
+export function sumSampleCost(events: Pick<UsageEvent, 'id' | 'timestamp' | 'cost_usd' | 'cost_available'>[], start: number, end: number): number {
+  const seen = new Set<string>()
+  let cost = 0
+  for (const event of events) {
+    const at = Date.parse(event.timestamp)
+    if (!Number.isFinite(at)) throw new Error('请求时间无效，暂无法估算')
+    if (at < start || at >= end) continue
+    if (event.id && seen.has(event.id)) continue
+    if (event.id) seen.add(event.id)
+    if (!event.cost_available || !Number.isFinite(event.cost_usd) || (event.cost_usd ?? -1) < 0) {
+      throw new Error('采样期有请求缺少价格，请先补齐模型价格')
+    }
+    cost += event.cost_usd!
+  }
+  return cost
+}
