# T53 admin lab: keep this block before the production fallback proxy.
@admin_lab_root path /admin/lab /admin/lab/
redir @admin_lab_root /admin/lab/login 302

@admin_lab_assets path /admin/lab/assets/* /admin/lab/logo.svg
handle @admin_lab_assets {
  uri strip_prefix /admin/lab
  reverse_proxy admin-lab-gateway:8088
}

@admin_lab_api path /admin/lab/api/*
handle @admin_lab_api {
  uri strip_prefix /admin/lab/api
  reverse_proxy admin-lab-gateway:8088 {
    header_up -Cookie
    header_up Authorization {http.request.header.Authorization}
    header_up X-Admin-Lab-Only 1
  }
}

@admin_lab_ws path /admin/lab/ws/*
handle @admin_lab_ws {
  uri strip_prefix /admin/lab
  reverse_proxy admin-lab-gateway:8088 {
    header_up -Cookie
    header_up Authorization {http.request.header.Authorization}
    header_up X-Admin-Lab-Only 1
  }
}

@admin_lab_login path /admin/lab/login
handle @admin_lab_login {
  uri strip_prefix /admin/lab
  reverse_proxy admin-lab-gateway:8088
}

@admin_lab_no_session {
  path /admin/lab/*
  not path /admin/lab/login /admin/lab/assets/* /admin/lab/logo.svg /admin/lab/api/* /admin/lab/ws/*
  not header Cookie *sub2api_lab_session=*
}
redir @admin_lab_no_session /admin/lab/login 302

@admin_lab_app path /admin/lab/*
handle @admin_lab_app {
  forward_auth admin-lab-gateway:8088 {
    uri /api/v1/auth/lab-session
    header_up X-Admin-Lab-Only 1
  }
  uri strip_prefix /admin/lab
  reverse_proxy admin-lab-gateway:8088 {
    header_up -Cookie
  }
}
