{
	auto_https disable_redirects
}

cpa-test.xingqiaolab.top {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode zstd gzip
	redir / /management.html 302
	redir /keeper /keeper/ 308
	@keeper_assets path /keeper/assets/*
	handle @keeper_assets {
		uri strip_prefix /keeper
		root * /etc/caddy/keeper-current
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@keeper_ui path /keeper/ /keeper/overview /keeper/realtime /keeper/analysis /keeper/ranking /keeper/request-events /keeper/auth-files /keeper/ai-provider /keeper/settings /keeper/key-overview /keeper/key-realtime /keeper/key-analysis /keeper/key-ranking
	handle @keeper_ui {
		root * /etc/caddy/keeper-current
		rewrite * /index.html
		header Cache-Control "no-store"
		header Content-Security-Policy "frame-ancestors 'self'"
		file_server
	}
	handle /keeper/* {
		reverse_proxy cpa-usage-keeper:8080
	}
	handle /v1/* {
		reverse_proxy cpa-gateway:8317 {
			transport http {
				dial_timeout 5s
				response_header_timeout 2m
			}
		}
	}
	@management_page path /management.html /index.html
	handle @management_page {
		root * /etc/caddy
		rewrite * /management.html
		header Cache-Control "no-store"
		file_server
	}
	handle /v0/resource/plugins/cliproxy-ticket-gateway/ui {
		root * /etc/caddy
		rewrite * /ticket-gateway-ui.html
		header Cache-Control "no-store"
		file_server
	}
	handle {
		reverse_proxy cpa-gateway:8317 {
			transport http {
				dial_timeout 5s
				response_header_timeout 2m
			}
		}
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
