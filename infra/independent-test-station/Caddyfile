:80 {
  encode zstd gzip
  @homepage_index path / /home /home/
  handle @homepage_index {
    root * /srv/home
    rewrite * /index.html
    header Cache-Control "no-store, max-age=0"
    file_server
  }
  @homepage_assets path /home-assets/*
  handle @homepage_assets {
    root * /srv/home
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  @docs path /docs /docs/*
  handle @docs {
    root * /srv/home
    file_server
  }
  @app_html {
    header Accept *text/html*
    not path /api/* /ws/* /health /readyz /home-assets/* /docs/*
  }
  handle @app_html {
    root * /srv/sub2api-update-ui
    rewrite * /index.html
    header Cache-Control "no-store, max-age=0"
    file_server
  }
  reverse_proxy /api/* test-station-api:8080
  reverse_proxy /ws/* test-station-api:8080
  reverse_proxy /health test-station-api:8080
  reverse_proxy /readyz test-station-api:8080
  reverse_proxy test-station-api:8080
}
