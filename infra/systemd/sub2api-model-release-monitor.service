[Unit]
Description=Sub2API read-only model release monitor
Wants=docker.service
After=docker.service network-online.target
ConditionPathExists=/opt/sub2api/production/ops/model-release/run-model-release-monitor.sh

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/sub2api/model-release-monitor.env
Environment=DOCKER_CONFIG=/run/model-release-monitor
ExecStart=/opt/sub2api/production/ops/model-release/run-model-release-monitor.sh
RuntimeDirectory=model-release-monitor
UMask=0077
TimeoutStartSec=4min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
