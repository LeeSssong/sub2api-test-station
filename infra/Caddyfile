{
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:172.30.0.3/32}
		trusted_proxies_strict
		timeouts {
			# Large-context clients on unstable links may need more than five
			# minutes to finish uploading, but abandoned bodies must stay bounded.
			read_body 15m
		}
	}
}

:8081 {
	reverse_proxy {$SUB2API_ACTIVE_UPSTREAM:sub2api-blue:8080} {
		# relay-ops already receives these values from the public Caddy hop.
		# Preserve them so Sub2API validates the browser-bound admin session.
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		header_up X-Real-IP {http.request.header.X-Real-IP}
	}
}

{$SITE_ADDRESS} {
	tls {
		key_type rsa2048
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}

	encode zstd gzip

	@homepage_index {
		path / /home /home/
		file {
			root /srv/home
			try_files /index.html
		}
	}
	handle @homepage_index {
		root * /srv/home
		rewrite * /index.html
		header Cache-Control "no-store, max-age=0"
		file_server
	}

	@homepage_config path /home-assets/site-config.json
	handle @homepage_config {
		root * /srv/home
		header Cache-Control "no-store, max-age=0"
		file_server
	}

	@homepage_assets path /home-assets/*
	handle @homepage_assets {
		root * /srv/home
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@docs_root path /docs
	redir @docs_root /docs/ 308

	@docs_index path /docs/
	handle @docs_index {
		root * /srv/home
		rewrite * /docs/index.html
		header Cache-Control "no-store, max-age=0"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		header X-Frame-Options SAMEORIGIN
		file_server
	}

	@docs_assets path /docs/*
	handle @docs_assets {
		root * /srv/home
		header Cache-Control "public, max-age=86400"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		header X-Frame-Options SAMEORIGIN
		file_server
	}

	@support_index path /support /support/
	handle @support_index {
		root * /srv/home
		rewrite * /index.html
		header Cache-Control "no-store, max-age=0"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		header X-Frame-Options SAMEORIGIN
		file_server
	}

	@support_assets path /support/*
	handle @support_assets {
		root * /srv/home
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@sub2api_update_js path /xingqiao-update-ui.js
	handle @sub2api_update_js {
		root * /srv/sub2api-update-ui
		rewrite * /update-ui.js
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@sub2api_update_css path /xingqiao-update-ui.css
	handle @sub2api_update_css {
		root * /srv/sub2api-update-ui
		rewrite * /update-ui.css
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@sub2api_binary_mutation {
		method POST
		path /api/v1/admin/system/rollback
	}
	respond @sub2api_binary_mutation `{"code":"DOCKER_DEPLOYMENT_UPDATE_REQUIRED","message":"Docker 部署仅支持受控 Compose 更新，请使用运维发布流程"}` 409

	@sub2api_official_index path /__sub2api-official-index
	handle @sub2api_official_index {
		rewrite * /
		reverse_proxy {$SUB2API_ACTIVE_UPSTREAM:sub2api-blue:8080}
	}

	@legacy_ops path /ops /ops/*
	redir @legacy_ops /admin/ops 302

	@retired_relay_ops_api path /relay-ops/api/ops-view /relay-ops/api/incidents/ack /relay-ops/api/feishu/events
	respond @retired_relay_ops_api 404

	@xingqiao_controlplane path /api/v1/xingqiao/*
	handle @xingqiao_controlplane {
		reverse_proxy relay-ops:8100 {
			# Relay forwards only the verified bearer to /auth/me; it does not
			# replay it to the official refresh endpoint.
			header_up -Cookie
			header_up User-Agent {http.request.header.User-Agent}
			header_up Origin {http.request.header.Origin}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
	}

	# Keep only health, pricing assets and the authenticated reconciliation API.
	# The retired relay-ops pages must not become public again.
	@relay_ops_public {
		path /healthz /readyz /pricing /relay-ops/static/app.css
	}
	reverse_proxy @relay_ops_public relay-ops:8100

	@relay_ops_reconciliation path /relay-ops/api/reconciliation/*
	handle @relay_ops_reconciliation {
		reverse_proxy relay-ops:8100
	}

	@retired_relay_ops_pages {
		path /relay-ops/*
		not path /relay-ops/api/reconciliation/*
	}
	respond @retired_relay_ops_pages 404

	@sub2api_html {
		header Accept *text/html*
		not {
		path /api/* /relay-ops/* /ops /ops/* /health /home-assets/* /xingqiao-update-ui.* /__sub2api-official-index /admin/lab*
		}
	}
	handle @sub2api_html {
		root * /srv/sub2api-update-ui
		templates
		rewrite * /index.html
		file_server
	}

	@sub2api_version_check {
		method GET
		path /api/v1/admin/system/check-updates
	}
	reverse_proxy @sub2api_version_check {$SUB2API_ACTIVE_UPSTREAM:sub2api-blue:8080}

	@sub2api_update {
		method POST
		path /api/v1/admin/system/update
	}
	reverse_proxy @sub2api_update unix//run/sub2api-updater/updater.sock {
		transport http {
			dial_timeout 5s
			response_header_timeout 15m
		}
	}

	@sub2api_host_update_status {
		method GET
		path /api/v1/admin/system/host-update/status
	}
	reverse_proxy @sub2api_host_update_status unix//run/sub2api-updater/updater.sock

	@sub2api_host_update_readiness {
		method GET
		path /api/v1/admin/system/host-update/readiness
	}
	reverse_proxy @sub2api_host_update_readiness unix//run/sub2api-updater/updater.sock

	@sub2api_host_update_schedule {
		method DELETE
		path /api/v1/admin/system/host-update/schedule
	}
	reverse_proxy @sub2api_host_update_schedule unix//run/sub2api-updater/updater.sock

	@sub2api_restart_mutation {
		method POST
		path /api/v1/admin/system/restart
	}
	respond @sub2api_restart_mutation `{"code":"DOCKER_DEPLOYMENT_UPDATE_REQUIRED","message":"Docker 部署仅支持受控 Compose 更新，请使用运维发布流程"}` 409


	# The acceptance station is a separate Compose project reached only through
	# the host edge port. Keep this before the production fallback so the native
	# /admin/accounts page remains handled by the production upstream. The route
	# is explicit so the source allowlist is checked before redirect/proxy.
	@acceptance_lab path /admin/lab /admin/lab/*
	route @acceptance_lab {
		@acceptance_lab_denied not client_ip {$ACCEPTANCE_LAB_ALLOWED_IPS:127.0.0.1/32}
		respond @acceptance_lab_denied 403

		@acceptance_lab_root path /admin/lab
		redir @acceptance_lab_root /admin/lab/ 308

		reverse_proxy {$ACCEPTANCE_LAB_UPSTREAM:host.docker.internal:8181} {
			header_up X-Forwarded-Proto {http.request.proto}
		}
	}

	reverse_proxy {$SUB2API_ACTIVE_UPSTREAM:sub2api-blue:8080} {
		flush_interval -1
		header_down Content-Security-Policy "frame-src " "frame-src 'self' https://shop.xingqiaolab.top https://catfk.com "
		transport http {
			dial_timeout 10s
			# Starts after Caddy has finished writing the request (including its
			# body) upstream; read_body above is the slow-upload protection.
			response_header_timeout 15m
			keepalive 30s
		}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	log {
		output stdout
		format json
	}
}

{$STOREFRONT_SITE_ADDRESS:https://shop.xingqiaolab.top} {
	encode zstd gzip

	@catfk_storefront_entry {
		path / /shop/DLK8SNUJ /shop/DLK8SNUJ/
	}
	handle @catfk_storefront_entry {
		route {
			# Match WAWA: CatFK receives the complete authenticated storefront query.
			header Cache-Control "no-store, max-age=0"
			header Content-Type "text/html; charset=utf-8"
			header Referrer-Policy "no-referrer"
			redir https://catfk.com/shop/DLK8SNUJ?{http.request.uri.query} 302
		}
	}

	respond 404

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; frame-ancestors https://api.xingqiaolab.top; base-uri 'none'; form-action 'none'"
	}
}
