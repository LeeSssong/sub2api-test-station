@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest'
+import { estimatePool, needsNewBaseline, sumSampleCost } from '../poolMath'
+const base = { at: 1000, fingerprint: 'same-pool', remaining: [0.94, 0.95] }
+describe('pool quota estimates', () => {
+  it('uses only quota consumption since a mid-cycle baseline', () => {
+    const result = estimatePool(base, [0.70, 0.95], 55.75484226)
+    expect(result.total).toBeCloseTo(464.6236855)
+    expect(result.remaining).toBeCloseTo(383.31454054)
+    expect(result.dropPoints).toBeCloseTo(24)
+  })
+  it('supports simultaneous consumption by several accounts', () => {
+    const result = estimatePool({ ...base, remaining: [1, 1] }, [0.8, 0.9], 120)
+    expect(result.total).toBeCloseTo(800)
+    expect(result.remaining).toBeCloseTo(680)
+  })
+  it('does not invent a dollar estimate before percentage changes', () => {
+    expect(estimatePool(base, base.remaining, 10).remaining).toBeNull()
+    expect(estimatePool(base, [0.7, 0.95], 0).total).toBeNull()
+  })
+  it('shows zero remaining after an observed depletion', () => {
+    expect(estimatePool({ ...base, remaining: [1, 1] }, [0, 0], 800).remaining).toBe(0)
+  })
+  it('starts over on member, price, window or percentage reset', () => {
+    expect(needsNewBaseline(base, 'changed', [0.7, 0.95])).toBe(true)
+    expect(needsNewBaseline(base, base.fingerprint, [1, 0.95])).toBe(true)
+    expect(needsNewBaseline(base, base.fingerprint, [0.7, 0.95])).toBe(false)
+  })
+  it('excludes pre-baseline and post-observation requests and deduplicates', () => {
+    const rows = [
+      { id: '1', timestamp: new Date(999).toISOString(), cost_usd: 99, cost_available: true },
+      { id: '2', timestamp: new Date(1000).toISOString(), cost_usd: 3, cost_available: true },
+      { id: '2', timestamp: new Date(1000).toISOString(), cost_usd: 3, cost_available: true },
+      { id: '3', timestamp: new Date(2000).toISOString(), cost_usd: 99, cost_available: true },
+    ]
+    expect(sumSampleCost(rows, 1000, 2000)).toBe(3)
+  })
+  it('refuses unpriced or non-finite sample costs', () => {
+    expect(() => sumSampleCost([{ timestamp: new Date(1500).toISOString(), cost_available: false }], 1000, 2000)).toThrow()
+    expect(() => estimatePool(base, [NaN, 0.9], 10)).toThrow()
+  })
+})
