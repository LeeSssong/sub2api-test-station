index 0000000..54101d7
--- /dev/null
+++ b/web/src/components/usage/pool/PoolQuotaCard.tsx
@@ -0,0 +1,144 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { fetchPricing, fetchPricingRules, fetchUsageEvents, fetchUsageIdentities, fetchUsageQuotaCache, refreshUsageQuotas } from '@/lib/api'
+import type { UsageEvent, UsageQuotaCacheItem } from '@/lib/types'
+import { Card } from '@/components/ui/Card'
+import { Button } from '@/components/ui/Button'
+import { Input } from '@/components/ui/Input'
+import { estimatePool, needsNewBaseline, sumSampleCost, type PoolBaseline } from './poolMath'
+import styles from './PoolQuotaCard.module.scss'
+
+const KEY = 'xingqiao-keeper-pool-baseline-v1'
+const BASE_PATH = () => window.__APP_BASE_PATH__ || ''
+const key = () => `${KEY}:${BASE_PATH()}`
+const usd = (value: number | null) => value === null ? '等待采样' : new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: value > 0 && value < 0.01 ? 4 : 2 }).format(value)
+interface Sample { at: number; fingerprint: string; remaining: number[]; count: number }
+interface View { base: PoolBaseline; sample: Sample; cost: number; estimate: ReturnType<typeof estimatePool> }
+function readBase(): PoolBaseline | null {
+  try {
+    const v = JSON.parse(window.localStorage.getItem(key()) || 'null') as PoolBaseline | null
+    return v && Number.isFinite(v.at) && typeof v.fingerprint === 'string' && Array.isArray(v.remaining) ? v : null
+  } catch { return null }
+}
+function sampleFrom(items: UsageQuotaCacheItem[], indexes: string[], pricingKey: string): Sample {
+  const members = indexes.map(id => {
+    const item = items.find(v => v.auth_index === id)
+    const quota = item?.quota?.quota.find(v => v.scope === 'window' && v.window?.seconds === 604800)
+    const at = Date.parse(item?.refreshed_at || '')
+    if (item?.status !== 'completed' || !quota || !quota.resetAt || !Number.isFinite(at)
+      || Date.now() - at > 6 * 60 * 1000 || at > Date.now() + 30000
+      || !Number.isFinite(quota.usedPercent) || quota.usedPercent! < 0 || quota.usedPercent! > 100) {
+      throw new Error('有账号的周配额尚未更新，请点击刷新采样')
+    }
+    return { id, at, reset: quota.resetAt, plan: item.quota?.subscription?.plan || '', remaining: 1 - quota.usedPercent! / 100 }
+  })
+  if (new Set(members.map(v => v.plan)).size > 1) throw new Error('账号套餐不同，暂不按等容量号池估算')
+  if (Math.max(...members.map(v => v.at)) - Math.min(...members.map(v => v.at)) > 30000) {
+    throw new Error('配额采样时间未对齐，请点击刷新采样')
+  }
+  return { at: Math.min(...members.map(v => v.at)), fingerprint: JSON.stringify([pricingKey, members.map(({ id, reset, plan }) => [id, reset, plan])]), remaining: members.map(v => v.remaining), count: members.length }
+}
+async function sampleEvents(start: number, signal: AbortSignal): Promise<UsageEvent[]> {
+  let cursor: string | undefined
+  const events: UsageEvent[] = []
+  for (let page = 0; page < 100; page++) {
+    const data = await fetchUsageEvents({ range: '30d' }, signal, { pageSize: 100, cursorMode: true, cursor })
+    events.push(...data.events)
+    if (!data.has_more || data.events.some(v => Date.parse(v.timestamp) < start)) return events
+    if (!data.next_cursor || data.next_cursor === cursor) throw new Error('用量分页异常，暂无法估算')
+    cursor = data.next_cursor
+  }
+  throw new Error('本次采样请求超过 10000 条，请重新建立基线')
+}
+export function PoolQuotaCard() {
+  const baseRef = useRef<PoolBaseline | null>(readBase())
+  const busy = useRef(false)
+  const controller = useRef<AbortController | null>(null)
+  const lastRefresh = useRef(0)
+  const [view, setView] = useState<View | null>(null)
+  const [error, setError] = useState('')
+  const [loading, setLoading] = useState(false)
+  const [multiplier, setMultiplier] = useState(() => {
+    try { return window.localStorage.getItem(`${key()}:multiplier`) || '0.2' } catch { return '0.2' }
+  })
+  const load = useCallback(async (force = false, reset = false) => {
+    if (busy.current || document.hidden) return
+    busy.current = true
+    setLoading(true)
+    const abort = new AbortController()
+    controller.current = abort
+    try {
+      const [identities, pricing] = await Promise.all([fetchUsageIdentities(abort.signal), fetchPricing(abort.signal)])
+      const indexes = identities.identities.filter(v => v.auth_type === 1 && v.type === 'codex' && !v.disabled && !v.is_deleted).map(v => v.identity).sort()
+      if (!indexes.length) throw new Error('当前没有启用的 Codex 账号')
+      if (!pricing.pricing.length || pricing.pricing.some(v => v.price_multiplier !== 1)) {
+        throw new Error('请先在模型价格中配置价格，并将价格倍率设为 1；扣费倍率在此单独输入')
+      }
+      const rules = await Promise.all(pricing.pricing.map(v => fetchPricingRules(v.model, abort.signal)))
+      if (rules.some(v => (v.rules ?? []).some(r => r.multiplier !== 1))) throw new Error('模型价格存在额外倍率规则，请先统一为 1×')
+      const pricingKey = JSON.stringify(pricing.pricing.slice().sort((a, b) => a.model.localeCompare(b.model)))
+      if (force || Date.now() - lastRefresh.current > 4 * 60 * 1000) {
+        const submittedAt = Date.now() - 1000
+        const tasks = await refreshUsageQuotas(indexes, abort.signal)
+        if ((tasks.rejected ?? []).some(v => !['duplicate', 'duplicate_request'].includes(v.error))) throw new Error('部分账号配额刷新被拒绝，请检查凭证状态')
+        lastRefresh.current = Date.now()
+        // The native refresh queue is asynchronous. Read only completed, newly refreshed cache entries.
+        for (let attempt = 0; attempt < 30; attempt++) {
+          const cache = await fetchUsageQuotaCache(indexes, abort.signal)
+          if (indexes.every(id => cache.items.some(v => v.auth_index === id && v.status === 'completed' && Date.parse(v.refreshed_at || '') >= submittedAt))) break
+          if (attempt === 29) throw new Error('配额刷新尚未完成，请稍后重试')
+          await new Promise<void>((resolve, reject) => {
+            const timer = setTimeout(resolve, 1000)
+            abort.signal.addEventListener('abort', () => { clearTimeout(timer); reject(new DOMException('Aborted', 'AbortError')) }, { once: true })
+          })
+        }
+      }
+      const cache = await fetchUsageQuotaCache(indexes, abort.signal)
+      const sample = sampleFrom(cache.items, indexes, pricingKey)
+      let base = baseRef.current
+      if (reset || !base || needsNewBaseline(base, sample.fingerprint, sample.remaining) || sample.at - base.at > 8 * 86400000) {
+        base = { at: sample.at, fingerprint: sample.fingerprint, remaining: sample.remaining }
+        baseRef.current = base
+        try { window.localStorage.setItem(key(), JSON.stringify(base)) } catch { /* Session state continues without persistent storage. */ }
+      }
+      if (sample.at < base.at) throw new Error('配额采样时间早于基线，请刷新采样')
+      const events = sample.at === base.at ? [] : await sampleEvents(base.at, abort.signal)
+      const cost = sumSampleCost(events, base.at, sample.at)
+      if (abort.signal.aborted) return
+      setView({ base, sample, cost, estimate: estimatePool(base, sample.remaining, cost) })
+      setError('')
+    } catch (e) {
+      if (!abort.signal.aborted) { setError(e instanceof Error ? e.message : '号池数据读取失败'); setView(null) }
+    } finally {
+      busy.current = false
+      if (!abort.signal.aborted) setLoading(false)
+    }
+  }, [])
+  useEffect(() => {
+    void load()
+    const timer = setInterval(() => { void load() }, 60000)
+    const onVisible = () => { if (!document.hidden) void load() }
+    document.addEventListener('visibilitychange', onVisible)
+    return () => { clearInterval(timer); document.removeEventListener('visibilitychange', onVisible); controller.current?.abort() }
+  }, [load])
+  const rate = multiplier.trim() === '' ? NaN : Number(multiplier)
+  const validRate = Number.isFinite(rate) && rate >= 0
+  return <Card title="号池额度 · 1×" subtitle="所有 API Key · 当前启用的 Codex 周额度号池" className={styles.card}
+    extra={<div className={styles.actions}><Button variant="secondary" onClick={() => void load(true)} disabled={loading} loading={loading}>刷新采样</Button><Button variant="ghost" onClick={() => void load(true, true)} disabled={loading}>重新开始采样</Button></div>}>
+    {error && <p role="alert" className={styles.error}>{error}</p>}
+    <div className={styles.metrics}>
+      <div><span>采样期标准用量</span><strong>{usd(view?.cost ?? null)}</strong></div>
+      <div><span>预计号池总额度</span><strong>{usd(view?.estimate.total ?? null)}</strong></div>
+      <div className={styles.remaining}><span>预计剩余额度</span><strong>{usd(view?.estimate.remaining ?? null)}</strong></div>
+      <div><span>按倍率推算扣费</span><strong>{usd(view && validRate ? view.cost * rate : null)}</strong></div>
+    </div>
+    <div className={styles.footer}><Input label="模拟扣费倍率" value={multiplier} type="number" min="0" step="0.01" onChange={e => {
+      setMultiplier(e.target.value)
+      try { window.localStorage.setItem(`${key()}:multiplier`, e.target.value) } catch { /* Keep the input usable. */ }
+    }} error={validRate ? undefined : '请输入不小于 0 的倍率'} />
+      <p>{view ? `${view.sample.count} 个账号 · 平均剩余 ${(view.estimate.averageRemaining * 100).toFixed(1)}% · 采样下降 ${view.estimate.dropPoints.toFixed(1)} 个百分点` : '正在读取号池配额'}<br />
+        {view && <>采样起点 {new Date(view.base.at).toLocaleString()} · 更新 {new Date(view.sample.at).toLocaleTimeString()}<br /></>}
+        按账号容量相近估算；扣费为模拟值。基线保存在当前浏览器。新号、配额重置或价格变化后重新采样。
+      </p>
+    </div>
+  </Card>
+}
diff --git a/web/src/components/usage/pool/poolMath.ts b/web/src/components/usage/pool/poolMath.ts
